# ==============================================================================
# CampusPulse Monorepo Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the workspace root or in apps/backend/.env
# Never commit real credentials or .env files to source control.

# --- Backend Configuration ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=campuspulse-development-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Local SQLite Database (Default for instant zero-dependency local dev)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Database (e.g. Supabase, Neon, AWS RDS)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuspulse?schema=public"

# --- Frontend Configuration (Production Deployments) ---
# Optional: Set when deploying frontend separately (e.g. Vercel, Netlify)
# VITE_API_URL=http://localhost:5000
